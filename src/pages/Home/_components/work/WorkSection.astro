---
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';
import WorkHeading from './WorkHeading.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const projects = t.work.projects;
---

<section
  id="work"
  class="relative z-10 bg-primary-cream"
>
  <div class="h-screen overflow-hidden flex items-center pl-[48px] pr-[200px]">
    <!-- Horizontal scroll track: title + cards se mueven juntos -->
    <div
      class="flex gap-[150px] items-center will-change-transform"
      data-animate="work-track"
    >
      <!-- Title block -->
      <WorkHeading title={t.work.title} subtitle={t.work.subtitle} />

      <!-- Project cards -->
      {
        projects.map((project) => (
          <ProjectCard
            number={project.number}
            total={project.total}
            title={project.title}
            description={project.description}
            statNumber={project.statNumber}
            statLabel={project.statLabel}
            bgImage={project.bgImage}
            overlayImage={project.overlayImage}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof gsap === 'undefined') return;

    const section = document.getElementById('work');
    if (!section) return;

    const track = section.querySelector('[data-animate="work-track"]') as HTMLElement;
    const subtitleEl = section.querySelector('[data-animate="work-subtitle"]') as HTMLElement;
    const titleLines = section.querySelectorAll('[data-animate="work-title"] p');

    if (!track) return;

    // Calculate scroll distance: how far the track needs to move left
    // so the last card aligns with the right edge of the visible content area
    const getScrollDistance = () => {
      const container = track.parentElement;
      if (!container) return 0;
      // container.clientWidth = viewport - pl[48] - pr[200]
      return Math.max(0, track.scrollWidth - container.clientWidth);
    };

    // =====================================================
    // 1. TITLE FADE IN (stagger similar to About)
    // =====================================================
    const titleTl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top bottom',
        end: 'top center',
        toggleActions: 'play none none reverse',
      },
    });

    titleTl.from(titleLines, {
      y: 50,
      opacity: 0,
      duration: 0.8,
      stagger: 0.15,
      ease: 'power3.out',
    });

    // =====================================================
    // 2. SUBTITLE RIGHT -> LEFT (Figma annotation)
    // =====================================================
    if (subtitleEl) {
      gsap.from(subtitleEl, {
        x: 200,
        opacity: 0,
        duration: 1.2,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: section,
          start: 'top bottom',
          end: 'top center',
          toggleActions: 'play none none reverse',
        },
      });
    }

    // =====================================================
    // 3. HORIZONTAL SCROLL — todo el track (title + cards)
    // =====================================================
    const horizontalScroll = () => {
      const scrollDistance = getScrollDistance();

      // Kill previous instance on refresh
      ScrollTrigger.getAll().forEach((st) => {
        if (st.vars.id === 'work-horizontal') st.kill();
      });

      if (scrollDistance <= 0) return;

      gsap.to(track, {
        x: () => -scrollDistance,
        ease: 'none',
        scrollTrigger: {
          id: 'work-horizontal',
          trigger: section,
          start: 'top top',
          end: () => `+=${scrollDistance}`,
          pin: true,
          pinSpacing: true,
          scrub: 1,
          invalidateOnRefresh: true,
        },
      });
    };

    horizontalScroll();

    // Refresh on resize
    window.addEventListener('resize', () => {
      ScrollTrigger.refresh();
    });
  });
</script>
