---
import { COPY_READY_CLASS } from '../../../../components/Copy/utils/copy/shared';
import { cn } from '../../../../lib/cn';
import Copy from '../../../../components/Copy/index.astro';

interface Props {
  title: string[];
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<div class="shrink-0" data-anim="work-heading">
  <!-- Main title: THE ODYSSEYS WE HELPED -->
  <div class={cn('flex flex-col', 'not-italic text-[#171717] whitespace-nowrap')}>
    <div
      class={cn(
        'h1 relative',
        'text-[64px] tb:text-[80px] dk:text-[160px]',
        'leading-none',
      )}
      data-anim="work-title"
    >
      <Copy
        variant="slide"
        type="words"
        stagger={0.2}
        trigger="#work"
        start="top 50%"
        reverse
      >
        {
          title.map((line, i) => (
            <p
              class={cn(
                'm-0 leading-none whitespace-pre',
                i === 1 && 'tb:ml-[1em]',
                i === 2 && 'tb:ml-[2em]',
              )}
            >
              {line}
            </p>
          ))
        }
      </Copy>
    </div>
    <!-- OUR WORK label -->
    <Copy
      variant="slide"
      type="chars"
      stagger={0.2}
      trigger="#work"
      start="top 50%"
      reverse
      delay={1}
    >
      <p
        class={cn(
          'font-neue-medium relative',
          'text-[16px]',
          'tracking-[20px] tb:tracking-[40px] dk:tracking-[67px] dk-lg:tracking-[105.8px]',
          'tb:ml-[11em] dk:ml-[22em]',
        )}
        data-anim="work-subtitle"
      >
        {subtitle}
      </p>
    </Copy>
  </div>
</div>
