---
import { cn } from '../../../../lib/cn';
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import Copy from '../../../../components/Copy/index.astro';

interface Props {
  title: string[];
  subtitle: string;
  lang?: Locale;
}

const { title, subtitle, lang = DEFAULT_LOCALE } = Astro.props;
const isEs = lang === 'es';
---

<div class="shrink-0" data-anim="work-heading">
  <!-- Main title: THE ODYSSEYS WE HELPED -->
  <div class={cn('flex flex-col', 'not-italic text-[#171717] whitespace-nowrap')}>
    <div
      class={cn(
        'h1 relative',
        'text-[64px] tb:text-[80px] dk:text-[160px]',
        'leading-none',
      )}
      data-anim="work-title"
    >
      <Copy
        variant="slide"
        type="words"
        stagger={0.2}
        trigger="#work"
        start="top 50%"
        reverse
      >
        {
          title.map((line, i) => (
            <p
              class={cn(
                'm-0 leading-none whitespace-pre',
                i === 1 && 'tb:ml-[1em]',
                i === 2 && 'tb:ml-[2em]',
              )}
            >
              {line}
            </p>
          ))
        }
      </Copy>
    </div>
    <!-- OUR WORK / PROYECTOS — tracking + ml tuned per locale (string length differs) -->
    <Copy
      variant="slide"
      type="chars"
      stagger={0.1}
      trigger="#work"
      start="top 50%"
      reverse
      delay={1}
    >
      <p
        class={cn(
          'font-neue-medium relative',
          // Figma mb 12 / tb 14 / dk 16
          'text-[12px] tb:text-[14px] dk:text-[16px]',
          'pt-[1em]',
          // EN: "OUR WORK" — mb tracking ~41 / ml ~5
          !isEs &&
            'tracking-[40px] tb:tracking-[50px] dk:tracking-[86px] dk-lg:tracking-[110px]',
          !isEs && 'ml-[5px] tb:ml-[170px] dk:ml-[17.7em] dk-lg:ml-[21.5em]',
          // ES: "PROYECTOS"
          isEs &&
            'tracking-[34px] tb:tracking-[43px] dk:tracking-[75px] dk-lg:tracking-[96px]',
          isEs && 'ml-[2px] tb:ml-[160px] dk:ml-[16.2em] dk-lg:ml-[20em]',
        )}
        data-anim="work-subtitle"
      >
        {subtitle}
      </p>
    </Copy>
  </div>
</div>
