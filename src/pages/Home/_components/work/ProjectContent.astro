---
import { cn } from '../../../../lib/cn';

interface Props {
  number: string;
  total: string;
  title: string;
  href?: string;
  description: string;
  statNumber: string;
  statLabel: string;
}

const { number, total, title, href, description, statNumber, statLabel } = Astro.props;
---

<div
  class={cn(
    // Figma mb: column (copy → stat bottom-right); tb: row; dk: column
    'flex flex-col items-end shrink-0 font-neue-medium not-italic',
    'tb:flex-row tb:flex-nowrap tb:items-start',
    'dk:flex-col',
    // Figma mb 28 / tb 60. Desktop stat sits closer under the description.
    'gap-28px tb:gap-60px dk:gap-32px',
    'w-full dk:w-[321px]',
  )}
  data-anim="project-content"
>
  <div
    class={cn(
      'flex w-full flex-col items-start',
      // Figma mb: 4 between number + title block
      'gap-4px tb:gap-8px',
    )}
  >
    <p
      class={cn(
        // Figma mb 10 / tb+ 14
        'text-[10px] tb:text-[14px] text-[#666] w-full',
      )}
      data-anim="project-number"
    >
      {number} / {total}
    </p>
    <div
      class={cn(
        'flex w-full flex-col items-start',
        // Figma mb 10 / tb 12 / dk 16
        'gap-10px tb:gap-12px dk:gap-16px',
      )}
    >
      <h3
        class={cn(
          'h3 text-black w-full m-0',
          'text-[32px] tb:text-[40px] dk:text-[52px]',
        )}
        data-anim="project-title"
      >
        <a
          href={href}
          target="_blank"
          rel="noreferrer"
          class="cursor-pointer text-inherit no-underline"
        >
          {title}
        </a>
      </h3>
      <p
        class={cn(
          'body-2 text-[#666] w-full m-0',
          'text-[14px] tb:text-[18px] dk:text-[20px]',
        )}
        data-anim="project-desc"
      >
        {description}
      </p>
    </div>
  </div>
  <div
    class={cn(
      'flex w-[115px] shrink-0 flex-col items-start text-black',
      // Figma mb 2 / tb+ 4
      'gap-2px tb:gap-4px',
    )}
  >
    <p
      class={cn(
        'leading-[1.1] w-full m-0',
        'text-[24px] tb:text-[36px] dk:text-[42px]',
      )}
      data-anim="project-stat"
    >
      {statNumber}
    </p>
    <p
      class={cn('body-2 w-full m-0', 'text-[14px] tb:text-[20px]')}
      data-anim="project-stat-label"
    >
      {statLabel}
    </p>
  </div>
</div>
