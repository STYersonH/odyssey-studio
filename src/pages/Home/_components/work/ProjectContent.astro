---
interface Props {
  number: string;
  total: string;
  title: string;
  description: string;
  statNumber: string;
  statLabel: string;
}

const { number, total, title, description, statNumber, statLabel } = Astro.props;
---

<div class="flex flex-col gap-[80px] items-start w-[321px] shrink-0 font-neue-medium leading-[1.1] not-italic">
  <div class="flex flex-col gap-[8px] items-start w-full">
    <p class="text-[14px] text-[#666] w-full" data-anim="project-number">{number} / {total}</p>
    <div class="flex flex-col gap-[16px] items-start w-full">
      <h3 class="h3 text-black w-full m-0" data-anim="project-title">{title}</h3>
      <p class="body-2 text-[#666] w-full m-0" data-anim="project-desc">{description}</p>
    </div>
  </div>
  <div class="flex flex-col gap-[4px] items-start text-black w-[237px]">
    <p class="text-[36px] leading-[1.1] w-full m-0" data-anim="project-stat">{statNumber}</p>
    <p class="body-2 w-full m-0" data-anim="project-stat-label">{statLabel}</p>
  </div>
</div>
