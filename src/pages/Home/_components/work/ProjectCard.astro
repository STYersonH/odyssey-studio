---
import { cn } from '../../../../lib/cn';
import ProjectMedia from './ProjectMedia.astro';
import ProjectContent from './ProjectContent.astro';

interface Props {
  number: string;
  total: string;
  title: string;
  href?: string;
  description: string;
  statNumber: string;
  statLabel: string;
  bgImage?: string;
  overlayImage?: string;
  bgColor?: string;
}

const {
  number,
  total,
  title,
  href,
  description,
  statNumber,
  statLabel,
  bgImage,
  overlayImage,
  bgColor = '#d6cec3',
} = Astro.props;
---

<div
  class={cn(
    'flex flex-col dk:flex-row dk:shrink-0',
    // Figma tb: 20 between media + content (60 was content-columns, not card)
    'gap-20px dk:gap-40px',
    'w-full dk:w-[1126px]',
  )}
  data-anim="project-card"
  data-bg={bgColor}
>
  <ProjectMedia bgImage={bgImage} overlayImage={overlayImage} href={href} title={title} />
  <ProjectContent
    number={number}
    total={total}
    title={title}
    href={href}
    description={description}
    statNumber={statNumber}
    statLabel={statLabel}
  />
</div>
