---
import { cn } from '../../../../lib/cn';
import ProjectMedia from './ProjectMedia.astro';
import ProjectContent from './ProjectContent.astro';

interface Props {
  number: string;
  total: string;
  title: string;
  description: string;
  statNumber: string;
  statLabel: string;
  bgImage?: string;
  overlayImage?: string;
  bgColor?: string;
}

const {
  number,
  total,
  title,
  description,
  statNumber,
  statLabel,
  bgImage,
  overlayImage,
  bgColor = '#d6cec3',
} = Astro.props;
---

<div
  class={cn(
    'flex',
    'gap-[20px] tb:gap-[60px] dk:gap-[40px]',
    'w-full dk:w-[1126px]  flex-col dk:flex-row dk:shrink-0',
  )}
  data-anim="project-card"
  data-bg={bgColor}
>
  <ProjectMedia bgImage={bgImage} overlayImage={overlayImage} />
  <ProjectContent
    number={number}
    total={total}
    title={title}
    description={description}
    statNumber={statNumber}
    statLabel={statLabel}
  />
</div>
