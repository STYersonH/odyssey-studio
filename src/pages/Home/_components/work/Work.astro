---
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';
import { cn } from '../../../../lib/cn';
import WorkHeading from './WorkHeading.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const projects = t.work.projects;
---

<section id="work" class="bg-primary-cream relative z-10">
  <div
    class={cn(
      // layout
      'flex flex-col',
      'dk:flex dk:h-screen dk:overflow-hidden dk:justify-center dk:items-start',
      // spacing responsive
      'px-[12px] py-[32px]',
      'tb:px-[24px] tb:py-[48px]',
      'dk:pl-[48px] dk:pr-[200px] dk:py-0',
    )}
  >
    <!-- Horizontal scroll track: title + cards se mueven juntos -->
    <div
      class={cn(
        'flex flex-col will-change-transform',
        // gap responsive
        'gap-[24px] tb:gap-[32px] dk:gap-[150px] dk-lg:gap-[300px]',
        // direction responsive
        'dk:flex-row justify-center',
      )}
      data-anim="work-track"
    >
      <!-- Title block -->
      <WorkHeading title={t.work.title} subtitle={t.work.subtitle} />

      <!-- Project cards -->
      {
        projects.map((project) => (
          <ProjectCard
            number={project.number}
            total={project.total}
            title={project.title}
            description={project.description}
            statNumber={project.statNumber}
            statLabel={project.statLabel}
            bgImage={project.bgImage}
            overlayImage={project.overlayImage}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initWorkAnimation } from './animation';

  document.addEventListener('astro:page-load', () => initWorkAnimation());
</script>
