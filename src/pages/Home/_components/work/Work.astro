---
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';
import { cn } from '../../../../lib/cn';
import WorkHeading from './WorkHeading.astro';
import ProjectCard from './ProjectCard.astro';
import ProjectStage from './ProjectStage.astro';
import NoiseOverlay from '../../../../components/noise-overlay/index.astro';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const projects = t.work.projects;
---

<section id="work" class="bg-primary-cream relative z-10 overflow-hidden">
  <NoiseOverlay />
  <!-- Desktop: park stage, then in-place project swaps -->
  <div
    class={cn(
      'hidden',
      // Full viewport strip — start from the LEFT (not centered) so park can slide cleanly
      'dk:flex dk:h-screen dk:w-full dk:flex-row dk:items-center dk:justify-start',
      'dk:overflow-hidden dk:px-48px dk:py-0',
    )}
  >
    <div
      class={cn(
        'flex w-max shrink-0 flex-row items-center will-change-transform',
        'gap-150px dk-lg:gap-300px',
      )}
      data-anim="work-track"
    >
      <WorkHeading lang={lang} title={t.work.title} subtitle={t.work.subtitle} />
      <ProjectStage projects={projects} />
    </div>
  </div>

  <!-- Desktop progress: visible only while a project is active -->
  <div
    class={cn(
      'pointer-events-none absolute right-[48px] bottom-[40px] z-20',
      'hidden flex-col items-end gap-3 opacity-0',
      'dk:flex',
    )}
    data-anim="work-progress"
    aria-hidden="true"
  >
    <p
      class={cn(
        'font-neue-medium m-0 text-[12px] tracking-[0.18em] text-neutral-900/50 uppercase',
      )}
      data-anim="work-progress-label"
    >
      — / {String(projects.length).padStart(2, '0')}
    </p>
    <div class="relative h-px w-[120px] bg-neutral-900/15">
      <div
        class="absolute top-0 left-0 h-full w-0 bg-neutral-900/70"
        data-anim="work-progress-bar"
      >
      </div>
    </div>
  </div>

  <!-- Mobile / tablet: vertical cards -->
  <div
    class={cn(
      'flex flex-col',
      // heading → cards: Figma mb/tb 60
      'gap-60px',
      // spacing — Figma WORK tb: px 24 / py 48
      'px-12px py-32px',
      'tb:px-24px tb:py-48px',
      'dk:hidden',
    )}
    data-anim="work-mobile"
  >
    <WorkHeading lang={lang} title={t.work.title} subtitle={t.work.subtitle} />
    <div
      class={cn(
        'flex w-full flex-col',
        // Figma mb 64 / tb 100 between projects
        'gap-64px tb:gap-100px',
      )}
    >
      {
        projects.map((project) => (
          <ProjectCard
            number={project.number}
            total={project.total}
            title={project.title}
            description={project.description}
            statNumber={project.statNumber}
            statLabel={project.statLabel}
            bgImage={project.bgImage}
            overlayImage={project.overlayImage}
            bgColor={project.bgColor}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initWorkAnimation } from './animation';

  document.addEventListener('astro:page-load', () => initWorkAnimation());
</script>
