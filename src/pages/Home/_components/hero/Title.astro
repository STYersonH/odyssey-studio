---
import { cn } from '../../../../lib/cn';
---

<div class="relative m-0 flex flex-col items-center">
  <!-- Keep ODYSSEY on one line: no spaces/newlines between parts (SplitText treats them as breaks). -->
  <p
    class={cn(
      'title-main-animate',
      'font-neue-medium leading-none font-black tracking-[0.04em] text-[var(--color-neutral-900)] whitespace-nowrap ',
      '[text-box:trim-both_cap_alphabetic]',
      'text-[4rem]',
      'mb:text-[clamp(4rem,11vw+2rem,7.5rem)]',
      'tb:text-[clamp(4rem,12vw+2rem,15.6rem)]',
      'dk:text-[clamp(10rem,13vw+2rem,18.75rem)]',
    )}
  >
    OD<span class="titulo-y font-neue-medium-italic">Y</span>SSE<span
      class="titulo-y font-neue-medium-italic">Y</span
    >
  </p>
  <p
    data-animate-title-studio
    class={cn(
      'font-roxborough absolute text-[20px] font-normal tracking-[0.12em] text-[var(--color-neutral-900)] md:text-[40px] lg:text-[clamp(1.8rem,4vw,3.5rem)]',
      '[text-box:trim-both_cap_alphabetic] leading-none',
      'right-5 mb:right-8 tb:right-16 dk:right-24',
      '-bottom-8 tb:-bottom-14 dk:-bottom-18 ',
    )}
  >
    Studio
  </p>
</div>

<style>
  /* :global() is required: SplitText injects .char at runtime. */
  :global(.title-main-animate .char) {
    display: inline-block;
    transform: translateY(100%);
    will-change: transform;
  }
</style>
