---
interface Props {
  paragraph1: string;
  paragraph2: string;
}

const { paragraph1, paragraph2 } = Astro.props;
---

<div class="tb:items-start flex w-full flex-col items-center">
  <p
    data-anim="description"
    class="text-block-animate tb:text-left body-3 w-full max-w-[244px] text-center text-neutral-900"
  >
    {paragraph1}
  </p>
  <p
    data-anim="description"
    class="text-block-animate tb:text-left body-3 mt-4 max-w-[244px] text-center text-neutral-900 md:mt-4"
  >
    {paragraph2}
  </p>
</div>

<style>
  /* :global() is required: SplitText injects .char at runtime. */
  :global([data-anim="description"] .line) {
    transform: translateY(100%);
    will-change: transform;
  }
</style>
