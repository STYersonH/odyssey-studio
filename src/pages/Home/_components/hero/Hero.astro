---
// import Navbar from '../layout/Navbar.astro';
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';
import { getLocalizedPath } from '../../../../i18n/utils';
import CompassRose from './CompassRose.astro';
import Title from './Title.astro';
import HeroText from './HeroText.astro';
import Coordinates from './Coordinates.astro';
import NeatBackground from '../../../../lib/neat-gradient/NeatBackground.tsx';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const heroContent = t.hero;
// const heroCtaHref = getLocalizedPath(lang, 'contact');
---

<section id="hero" class="hero-section z-20">
  <NeatBackground client:only="react" className="gradient-bg" />
  <!-- <Navbar /> -->
  <CompassRose />

  <!-- Content layer -->
  <div class="absolute inset-0 z-20 px-5 md:px-8">
    <!-- Title: centered -->
    <div
      class="absolute top-1/2 left-1/2 w-auto -translate-x-1/2 -translate-y-1/2 text-center"
    >
      <Title />
    </div>

    <!-- Text block + Coordinates -->
    <div class="flex h-full w-full items-end">
      <div
        class="mb:flex-row mb:gap-0 mb:items-end flex w-full flex-col items-center justify-between gap-[2rem] pb-[24px]"
      >
        <HeroText />
        <Coordinates />
      </div>
    </div>
  </div>
</section>

<script>
  import { initHeroAnimation } from './animation';

  document.addEventListener('astro:page-load', () => {
    void initHeroAnimation();
  });
</script>

<style>
  .hero-section {
    position: relative;
    min-height: 100vh;
    width: 100%;
    overflow: hidden;
  }

  .gradient-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
  }
</style>
