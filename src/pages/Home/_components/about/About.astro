---
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';
import { cn } from '../../../../lib/cn';
import NoiseOverlay from '../../../../components/noise-overlay/index.astro';
import AboutHeading from './AboutHeading.astro';
import AboutText from './AboutText.astro';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const headingLines: [string, string, string] = [
  t.about.heading.line1,
  t.about.heading.line2,
  t.about.heading.line3,
];
const textParagraphs: [string, string] = [
  t.about.text.paragraph1,
  t.about.text.paragraph2,
];
---

<section
  id="about"
  class="relative z-20 flex min-h-screen w-full items-end overflow-hidden bg-neutral-900"
>
  <NoiseOverlay />

  <div
    data-anim="enter"
    class={cn(
      'relative z-10 will-change-transform',
      'tb:flex-row flex h-full w-full flex-col gap-8 p-8 md:min-h-screen justify-end md:gap-20 lg:items-stretch lg:gap-5 ',
      'px-[0.75rem] mb:px-[1.5rem] tb:px-[2rem]',
      'py-4xl',
    )}
  >
    <AboutHeading lines={headingLines} />
    <AboutText paragraphs={textParagraphs} />
  </div>
</section>

<script>
  import { initAboutAnimation } from './animation';

  document.addEventListener('astro:page-load', () => {
    initAboutAnimation();
  });
</script>
