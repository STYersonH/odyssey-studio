---
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';
import { cn } from '../../../../lib/cn';
import AboutHeading from './AboutHeading.astro';
import AboutText from './AboutText.astro';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const headingLines: [string, string, string] = [
  t.about.heading.line1,
  t.about.heading.line2,
  t.about.heading.line3,
];
const textParagraphs: [string, string] = [
  t.about.text.paragraph1,
  t.about.text.paragraph2,
];
---

<section
  id="about"
  class="relative z-10 flex min-h-screen w-full items-center bg-neutral-900"
>
  <div
    class={cn(
      'tb:flex-row flex h-full w-full flex-col gap-8 p-8 md:min-h-screen md:justify-end md:gap-20 lg:items-stretch lg:gap-5 ',
      'px-[0.75rem] mb:px-[1.5rem] tb:px-[2rem]',
    )}
  >
    <AboutHeading lines={headingLines} />
    <AboutText paragraphs={textParagraphs} />
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    gsap.set('.title-main-animate', { opacity: 1 });

    ScrollTrigger.create({
      trigger: '#about',
      start: 'top bottom',
      end: 'bottom bottom',
      scrub: true,
      // markers: true,
      onUpdate: (self) => {
        const yValue = -35 * (1 - self.progress);
        gsap.set('#about', { y: `${yValue}%` });
      },
    });
  });
</script>
