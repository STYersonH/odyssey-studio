---
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';
import AboutHeading from './AboutHeading.astro';
import AboutText from './AboutText.astro';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
const headingLines = [t.about.heading.line1, t.about.heading.line2, t.about.heading.line3];
const textParagraphs = [t.about.text.paragraph1, t.about.text.paragraph2];
---

<section
  id="about"
  class="relative z-10 flex min-h-screen w-full items-center bg-[var(--color-neutral-900)]"
>
  <div
    class="flex h-full w-full flex-col gap-8 p-8 md:min-h-screen md:justify-end md:gap-20 md:px-6 md:py-12 lg:items-stretch lg:gap-5 lg:px-12 lg:py-16 2xl:px-16 2xl:py-20"
  >
    <div class="lg:col-span-7">
      <AboutHeading lines={headingLines} />
    </div>
    <AboutText paragraphs={textParagraphs} />
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof gsap === 'undefined') return;

    // Content reveal — animates as the section scrolls into view
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#about',
        start: 'top 80%',
        end: 'top 20%',
        toggleActions: 'play none none reverse',
      },
    });

    // Heading lines stagger in
    tl.from("[data-animate='about-heading'] p", {
      y: 50,
      opacity: 0,
      duration: 0.8,
      stagger: 0.15,
      ease: 'power3.out',
    });

    // Text paragraphs stagger in
    tl.from(
      "[data-animate='about-text'] p",
      {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.2,
        ease: 'power3.out',
      },
      '-=0.3',
    );
  });
</script>
