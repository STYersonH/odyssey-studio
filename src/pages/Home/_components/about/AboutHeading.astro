---
interface Props {
  lines: [string, string, string];
}

const { lines } = Astro.props;
---

<div
  data-anim="heading"
  class="h1 dk:flex-7/12 self-start leading-none whitespace-pre-wrap text-white"
>
  <p class="m-0">{lines[0]}</p>
  <p class="m-0">{lines[1]}</p>
  <p class="m-0">{lines[2]}</p>
</div>
