---
interface Props {
  paragraphs: [string, string];
}

const { paragraphs } = Astro.props;
---

<div
  data-animate="about-text"
  class="flex flex-col gap-3 self-end text-[24px] leading-[1.3] text-white md:items-end md:justify-end md:gap-6 md:pr-6 lg:w-full lg:max-w-[506px] lg:gap-8 lg:text-[25px] 2xl:max-w-[652px] 2xl:text-[40px]"
  style="font-family: var(--font-body); font-weight: 300"
>
  <p class="m-0 w-full md:w-[500px]">
    {paragraphs[0]}
  </p>
  <p class="m-0 mt-3 w-full md:mt-6 md:w-[500px] lg:mt-0 lg:mt-8">
    {paragraphs[1]}
  </p>
</div>
