---
import { cn } from '../../../../lib/cn';

interface Props {
  paragraphs: [string, string];
}

const { paragraphs } = Astro.props;
---

<div data-anim="text-column" class="tb:justify-start tb:flex-5/12 flex justify-end">
  <div
    data-anim="text-reveal"
    class={cn(
      'body-1 gap-xl flex flex-col self-end leading-[1.3] items-end justify-end md:pr-6',
      'w-[23.75rem] tb:w-[31.625rem] dk:w-[40.75rem]',
    )}
  >
    <p
      data-anim="text-block"
      data-text={paragraphs[0]}
      class="animate-text m-0 w-full will-change-[clip-path]"
    >
      {paragraphs[0]}
    </p>
    <p
      data-anim="text-block"
      data-text={paragraphs[1]}
      class="animate-text m-0 w-full will-change-[clip-path]"
    >
      {paragraphs[1]}
    </p>
  </div>
</div>

<style>
  /* About text reveal: grey base + white overlay clipped by --clip-value */
  .animate-text {
    position: relative;
    color: #2e2e2e;
    --clip-value: 100%;
  }

  .animate-text::before {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    font: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    color: #fff;
    clip-path: inset(0 0 var(--clip-value) 0);
    will-change: clip-path;
    pointer-events: none;
  }
</style>
