---
interface Props {
  paragraphs: [string, string];
}

const { paragraphs } = Astro.props;
---

<div data-anim="text-column" class="flex flex-5/12">
  <div
    class="body-1 gap-xl dk:w-[40.75rem] flex w-[31.625rem] flex-col self-end leading-[1.3] md:items-end md:justify-end md:pr-6"
  >
    <p data-anim="text-block" class="animate-text m-0 w-full">
      {paragraphs[0]}
    </p>
    <p data-anim="text-block" class="animate-text m-0 w-full">
      {paragraphs[1]}
    </p>
  </div>
</div>

<style is:global>
  .animate-text {
    position: relative;
    color: #4f4f4f;
    --clip-value: 100%;
  }

  .animate-text::before {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    font: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    color: #fff;
    clip-path: inset(0 0 var(--clip-value) 0);
    will-change: clip-path;
    pointer-events: none;
  }
</style>
