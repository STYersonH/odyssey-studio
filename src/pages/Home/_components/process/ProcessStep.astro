---
import { cn } from '../../../../lib/cn';

interface Props {
  number: string;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  /** 0 | 1 | 2 — drives staircase alignment + image side */
  index: number;
  showDivider?: boolean;
}

const {
  number,
  title,
  description,
  image,
  imageAlt = '',
  index,
  showDivider = false,
} = Astro.props;

/** Desktop step 03: image on the left; mb/tb always image on the right */
const imageSideDesktop = index === 2 ? 'left' : 'right';
---

<>
  <div
    class={cn(
      'flex w-full flex-col items-start p-10px will-change-[opacity]',
      // Staircase only from tb+: start → center → end (mb: all left)
      index === 1 && 'tb:items-center',
      index === 2 && 'tb:items-end',
    )}
    data-anim="process-step-wrap"
    data-step-index={String(index)}
  >
    <div
      class={cn(
        'flex items-start',
        // mb/tb: image always right; dk step 03: image left
        index === 2 && 'dk:flex-row-reverse',
        index === 0 || index === 1 ? 'gap-32px dk:gap-40px' : 'gap-20px dk:gap-40px',
        index === 0 && 'w-full dk:w-auto',
        index === 0 && 'items-start tb:items-center',
        index === 1 && 'justify-start tb:justify-center tb:items-center',
        index === 2 && 'justify-start tb:justify-end tb:items-center',
      )}
      data-anim="process-step"
    >
      <div class={cn('flex shrink-0 items-start gap-20px font-neue-medium not-italic')}>
        <div class="w-[1.8rem]">
          <p
            class={cn(
              'mt-[0.1rem] tb:mt-[0.3rem] shrink-0 text-[#666]',
              // Figma mb 390/20 → 5.13vw
              'text-[clamp(1rem,5.13vw,1.25rem)]',
              'leading-[1.1]',
            )}
            data-anim="process-step-number"
          >
            {number}
          </p>
        </div>

        <div
          class={cn(
            'flex flex-col items-start',
            // Figma mb 10 / tb 12 / dk+ 16
            'gap-10px tb:gap-12px dk:gap-16px',
          )}
        >
          <h3
            class={cn(
              'm-0 text-primary-dark',
              // Figma mb 390/24 → 6.15vw · tb 32 / dk 36 / dk-lg 40
              'text-[clamp(1.25rem,6.15vw,1.5rem)]',
              'tb:text-[2rem] dk:text-[2.25rem] dk-lg:text-[2.5rem]',
              'leading-[1.1]',
              'w-[10.125rem] tb:w-[15.5625rem]',
            )}
            data-anim="process-step-title"
          >
            {title}
          </h3>
          <p
            class={cn(
              'm-0 text-[#666]',
              // Figma mb 390/14 → 3.59vw · tb+ 18 / dk-lg 20
              'text-[clamp(0.75rem,3.59vw,0.875rem)]',
              'tb:text-[1.125rem] dk-lg:text-[1.25rem]',
              'leading-[1.3]',
              'w-[11rem] tb:w-[19.0625rem]',
              index === 0 && 'dk:w-[26rem]',
              index === 1 && 'dk:w-[26.875rem]',
              index === 2 && 'dk:w-[25.6875rem]',
            )}
            data-anim="process-step-desc"
          >
            {description}
          </p>
        </div>
      </div>

      {
        image && (
          <div
            class={cn(
              'relative shrink-0 will-change-[transform,opacity]',
              // Figma mb ~89×85 · tb ~128×179 · dk ~222×148
              'h-[5.3125rem] w-[5.5625rem]',
              'tb:h-[11.1875rem] tb:w-[8rem]',
              'dk:h-[9.25rem] dk:w-[13.875rem]',
            )}
            data-anim="process-step-image"
            data-image-side={imageSideDesktop}
          >
            <div class="size-full overflow-hidden rounded-[0.375rem]">
              <img
                src={image}
                alt={imageAlt}
                class="size-full object-cover"
                loading="lazy"
              />
            </div>
          </div>
        )
      }
    </div>
  </div>

  {
    showDivider && (
      <hr
        class="m-0 h-0 w-full border-0 border-t border-[#171717]/10"
        data-anim="process-divider"
        aria-hidden="true"
      />
    )
  }
</>
