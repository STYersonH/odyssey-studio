---
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';
import SloganImages from './SloganImages.astro';
import SloganText from './SloganText.astro';
import positions from './slogan-positions.json';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="slogan"
  class="relative z-10 min-h-screen w-full overflow-hidden bg-neutral-900"
  style="perspective: 2000px; transform-style: preserve-3d"
  data-positions={JSON.stringify(positions)}
>
  <SloganImages />
  <SloganText lines={t.slogan.lines} vision={t.slogan.vision} />
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof gsap === 'undefined') return;

    // =====================================================
    // 0. LENIS — Smooth Scroll (como prueba.astro)
    // =====================================================
    const lenis = new Lenis();
    lenis.on('scroll', ScrollTrigger.update);

    gsap.ticker.add((time) => {
      lenis.raf(time * 1000);
    });
    gsap.ticker.lagSmoothing(0);

    // =====================================================
    // 1. REFS (Agregamos la referencia a las 3 líneas superiores)
    // =====================================================
    const section = document.getElementById('slogan');
    if (!section) return;

    const img1 = section.querySelector("[data-animate='img-1']") as HTMLElement;
    const img2 = section.querySelector("[data-animate='img-2']") as HTMLElement;
    const img3 = section.querySelector("[data-animate='img-3']") as HTMLElement;
    const vision = section.querySelector("[data-animate='slogan-vision']") as HTMLElement;

    // Capturamos las 3 líneas que están encima de "YOUR VISION"
    const sloganLines = section.querySelectorAll("[data-animate='slogan-line']");
    const images = [img1, img2, img3];

    // =====================================================
    // 2. PARSE FIGMA POSITIONS DATA
    // =====================================================
    const positionsData = JSON.parse(section.dataset.positions || '{}');

    // =====================================================
    // 3. HELPERS
    // =====================================================
    /** Resuelve calc(…% + …px) o valores planos a px */
    function resolvePx(value: string, containerWidth: number): number {
      if (!value.includes('calc')) return parseFloat(value) || 0;
      const match = value.match(/calc\(([\d.]+)%\s*([+-])\s*([\d.]+)px\)/);
      if (match) {
        const pct = (parseFloat(match[1]) / 100) * containerWidth;
        const px = parseFloat(match[3]);
        return match[2] === '+' ? pct + px : pct - px;
      }
      return 0;
    }

    /** Detecta breakpoint actual basado en Tailwind defaults */
    function getBreakpoint(): 'base' | 'md' | 'lg' | '2xl' {
      const w = window.innerWidth;
      if (w >= 1536) return '2xl';
      if (w >= 1024) return 'lg';
      if (w >= 768) return 'md';
      return 'base';
    }

    /** Obtiene posiciones Figma resueltas a px para el breakpoint actual */
    function getEndPositions(bp: ReturnType<typeof getBreakpoint>) {
      const sectionW = section.offsetWidth;
      const keys = ['img1', 'img2', 'img3'] as const;
      return keys.map((key) => {
        const bpData =
          positionsData.images[key].breakpoints[
            bp as keyof (typeof positionsData.images)[typeof key]['breakpoints']
          ];
        return {
          left: resolvePx(bpData.left, sectionW),
          top: resolvePx(bpData.top, sectionW),
          width: parseFloat(bpData.width),
          height: parseFloat(bpData.height),
          z: 2000,
          scale: 1,
        };
      });
    }

    // =====================================================
    // 4. CURTAIN REVEAL — pin About mientras Slogan entra
    // =====================================================
    ScrollTrigger.create({
      trigger: '#slogan',
      start: 'top bottom',
      end: 'top top',
      pin: '#about',
      pinSpacing: false,
    });

    // =====================================================
    // 5. PHASE 1 — Prep positions & Fade in
    // =====================================================
    const startPositions = images.map((img) => {
      if (!img) return { left: 0, top: 0, width: 0, height: 0, z: -800, scale: 0.35 };

      const leftPx = img.offsetLeft;
      const topPx = img.offsetTop;

      gsap.set(img, {
        left: leftPx + 'px',
        top: topPx + 'px',
        right: 'auto',
        bottom: 'auto',
        position: 'absolute',
        autoAlpha: 0,
        z: -800, // <-- MODIFICADO: Menos profundo para que no inicien tan lejos
        scale: 0.35, // <-- MODIFICADO: Escala inicial más grande y visible
      });

      return {
        left: leftPx,
        top: topPx,
        width: img.offsetWidth,
        height: img.offsetHeight,
        z: -800,
        scale: 0.35,
      };
    });

    // Preparamos el texto de "YOUR VISION" y las 3 líneas superiores
    gsap.set(vision, { autoAlpha: 0, scale: 0.3, y: 0 });
    gsap.set(sloganLines, { autoAlpha: 0, y: -15 }); // Inician invisibles y un poco elevadas

    const phase1 = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top bottom',
        end: 'top top',
        scrub: 1,
      },
    });

    phase1.to(vision, { autoAlpha: 1, duration: 0.3 }, 1.4);
    phase1.to(img1, { autoAlpha: 1, duration: 0.3 }, '+<0.3');
    phase1.to(img2, { autoAlpha: 1, duration: 0.3 }, '+<0.2');
    phase1.to(img3, { autoAlpha: 1, duration: 0.3 }, '+<0.4');

    // =====================================================
    // 6. PHASE 2 — Travel forward & Text Stagger
    // =====================================================
    const bp = getBreakpoint();
    const endPositions = getEndPositions(bp).map((pos) => ({
      ...pos,
      z: 0,
      scale: 1,
    }));

    ScrollTrigger.create({
      trigger: section,
      start: 'top top',
      end: `+=${window.innerHeight * 4}px`,
      pin: true,
      pinSpacing: true,
      scrub: 1,
      onUpdate: (self) => {
        const progress = self.progress;

        // 1. "YOUR VISION": Crece en escala Y además baja 50px en el eje Y
        const visionScale = gsap.utils.interpolate(0.3, 1, progress);
        const visionY = gsap.utils.interpolate(0, 50, progress); // <-- Nueva bajada sutil
        gsap.set(vision, { scale: visionScale, y: visionY });

        // 2. LAS 3 LÍNEAS SUPERIORES: Aparecen en cascada una por una (de arriba a abajo)
        sloganLines.forEach((line, index) => {
          // Cada línea empieza su animación con un retraso (stagger) diferente
          // Línea 1: empieza en progress 0.0 | Línea 2: en 0.15 | Línea 3: en 0.30
          const lineStart = index * 0.15;

          // Calculamos su propio progreso interno acelerado (multiplicado por 3) para que termine rápido
          const lineProgress = Math.max(0, Math.min(1, (progress - lineStart) * 3));

          gsap.set(line, {
            autoAlpha: lineProgress, // Va de opacidad 0 a 1
            y: gsap.utils.interpolate(-15, 0, lineProgress) + 'px', // Cae sutilmente a su posición original
          });
        });

        // 3. ANIMACIÓN DE LAS IMÁGENES
        images.forEach((img, i) => {
          if (!img) return;

          const stagger = i * 0.08;
          const imgProgress = Math.max(0, Math.min(1, (progress - stagger) * 2.0));

          const s = startPositions[i];
          const e = endPositions[i];

          gsap.set(img, {
            z: gsap.utils.interpolate(s.z, e.z, imgProgress),
            scale: gsap.utils.interpolate(s.scale, e.scale, imgProgress),
            left: gsap.utils.interpolate(s.left, e.left, imgProgress) + 'px',
            top: gsap.utils.interpolate(s.top, e.top, imgProgress) + 'px',
          });
        });
      },
    });
    // =====================================================
    // 7. REFRESH on resize
    // =====================================================
    window.addEventListener('resize', () => {
      ScrollTrigger.refresh();
    });
  });
</script>
