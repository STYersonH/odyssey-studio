---
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/utils';
import SloganImages from './SloganImages.astro';
import SloganText from './SloganText.astro';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="slogan"
  class="relative z-10 min-h-screen w-full overflow-hidden bg-neutral-900"
  style="perspective: 2000px; transform-style: preserve-3d"
>
  <SloganImages />
  <SloganText lines={t.slogan.lines} vision={t.slogan.vision} />
</section>

<script>
  import { initSloganAnimation } from './animation';

  document.addEventListener('astro:page-load', () => {
    initSloganAnimation();
  });
</script>
