---
import { cn } from '../../../../lib/cn';
---

<div
  data-anim="slogan-images"
  class="relative z-20 h-[100vh] w-full [transform-style:preserve-3d]"
>
  <!-- left/top = center of each image (-translate-x/y-1/2) -->
  <div
    data-anim="img-1"
    class={cn(
      ' h-[129px] w-[179px] object-cover will-change-transform tb:h-[186px] tb:w-[258px] dk:h-[191px] dk:w-66.25',
      'absolute top-[44%] left-[45%] tb:top-[38%] tb:left-[45%] -translate-x-1/2 -translate-y-1/2 ',
    )}
  >
    <img src="/images/image-flowers.png" alt="" class="h-full w-full object-cover" />
    <div class="absolute inset-0 bg-black/30"></div>
  </div>

  <div
    data-anim="img-2"
    class={cn(
      'h-[129px] w-[179px] object-cover will-change-transform tb:h-[223px] tb:w-[309px] dk:h-[223px] dk:w-[309px]',
      'absolute top-[47%] left-[64%] tb:top-[45%] tb:left-[62%] -translate-x-1/2 -translate-y-1/2 ',
    )}
  >
    <img src="/images/image-woman.png" alt="" class="h-full w-full object-cover" />
  </div>

  <div
    data-anim="img-3"
    class={cn(
      ' h-[129px] w-[179px] object-cover will-change-transform  tb:h-[178px] tb:w-[246px] dk:h-[178px] dk:w-[246px]',
      'absolute top-[53.5%] left-[36%] tb:top-[55%] tb:left-[38%] -translate-x-1/2 -translate-y-1/2 ',
    )}
  >
    <img src="/images/image-building.png" alt="" class="h-full w-full object-cover" />
  </div>
</div>
