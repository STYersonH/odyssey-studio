<div
  data-animate="slogan-images"
  class="absolute inset-0"
  style="transform-style: preserve-3d"
>
  <!-- Image 1: Flowers (top-left area in final position) -->
  <div
    data-animate="img-1"
    class="absolute right-[45%] bottom-[47%] h-[129px] w-[179px] [transform-origin:center_center] object-cover opacity-0 will-change-transform md:h-[178px] md:w-[246px] lg:h-[186px] lg:w-[258px] 2xl:h-[191px] 2xl:w-66.25"
  >
    <img src="/images/image-flowers.png" alt="" class="h-full w-full object-cover" />
    <div class="absolute inset-0 bg-black/30"></div>
  </div>

  <!-- Image 2: Woman (right side in final position) -->
  <div
    data-animate="img-2"
    class="absolute top-[34%] left-[50%] h-[88px] w-[122px] [transform-origin:center_center] object-cover opacity-0 will-change-transform md:h-[149px] md:w-[206px] lg:h-[223px] lg:w-[309px] 2xl:h-[223px] 2xl:w-[309px]"
  >
    <img src="/images/image-woman.png" alt="" class="h-full w-full object-cover" />
  </div>

  <!-- Image 3: Building (bottom-left in final position) -->
  <div
    data-animate="img-3"
    class="absolute top-[41%] right-1/2 h-[129px] w-[179px] [transform-origin:center_center] object-cover opacity-0 will-change-transform md:h-[151px] md:w-[208px] lg:h-[178px] lg:w-[246px] 2xl:h-[178px] 2xl:w-[246px]"
  >
    <img src="/images/image-building.png" alt="" class="h-full w-full object-cover" />
  </div>
</div>
