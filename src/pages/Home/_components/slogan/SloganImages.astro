---
import { cn } from '../../../../lib/cn';
---

<div
  data-anim="slogan-images"
  class="relative z-20 h-[100vh] w-full [transform-style:preserve-3d]"
>
  <div
    data-anim="img-1"
    class={cn(
      'absolute -translate-x-1/2 -translate-y-1/2 will-change-transform',
      'top-[38.3%] left-[40.8%] tb:top-[39.5%] tb:left-[40.2%] dk:top-[38%] dk:left-[45%]',
      'h-[95px] w-[131px] tb:h-[147px] tb:w-[204px] dk:h-[186px] dk:w-[258px] dk-lg:h-[191px] dk-lg:w-66.25',
    )}
  >
    <img src="/images/image-flowers.png" alt="" class="h-full w-full object-cover" />
    <div class="absolute inset-0 bg-black/30"></div>
  </div>

  <div
    data-anim="img-2"
    class={cn(
      'absolute -translate-x-1/2 -translate-y-1/2 will-change-transform',
      'top-[51.5%] left-[67.1%] tb:top-[46.5%] tb:left-[63.2%] dk:top-[45%] dk:left-[62%]',
      'h-[88px] w-[122px] tb:h-[149px] tb:w-[206px] dk:h-[223px] dk:w-[309px] dk-lg:h-[223px] dk-lg:w-[309px]',
    )}
  >
    <img src="/images/image-woman.png" alt="" class="h-full w-full object-cover" />
  </div>

  <div
    data-anim="img-3"
    class={cn(
      'absolute -translate-x-1/2 -translate-y-1/2 will-change-transform',
      'top-[57%] left-[29.9%] tb:top-[56%] tb:left-[32%] dk:top-[55%] dk:left-[38%]',
      'h-[129px] w-[179px] tb:h-[151px] tb:w-[208px] dk:h-[178px] dk:w-[246px] dk-lg:h-[178px] dk-lg:w-[246px]',
    )}
  >
    <img src="/images/image-building.png" alt="" class="h-full w-full object-cover" />
  </div>
</div>
