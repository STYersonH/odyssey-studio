---
import { cn } from '../../../../lib/cn';
import type { Locale } from '../../../../i18n/locales';
import { DEFAULT_LOCALE } from '../../../../i18n/locales';
import Copy from '../../../../components/Copy/index.astro';

interface Props {
  title: string[];
  subtitle: string;
  subtitleDesktop: string;
  lang?: Locale;
}

const { title, subtitle, subtitleDesktop, lang = DEFAULT_LOCALE } = Astro.props;
const isEs = lang === 'es';
/** mb/tb: first word on its own line, rest below (e.g. OUR / SERVICES). */
const subtitleWords = subtitle.trim().split(/\s+/);
---

<!--
  Title first, then subtitle under — same idea as Process / Work.
  mb/tb: subtitle stacked + right-aligned.
  dk+: single line with tracking indent.
-->
<div
  class={cn('relative flex w-full shrink-0 flex-col items-start dk:w-auto')}
  data-anim="services-heading"
>
  <div
    class={cn(
      'relative text-white font-neue-medium',
      // Figma mb/tb 80 / dk 90 / dk-lg 150
      'text-[4rem] dk:text-[5.625rem] dk-lg:text-[9.375rem]',
      'leading-none',
      'whitespace-normal tb:whitespace-nowrap',
    )}
    data-anim="services-title"
  >
    <Copy
      variant="slide"
      type="words"
      stagger={0.2}
      trigger="#services"
      start="top 50%"
      reverse
    >
      {
        title.map((line, i) => (
          <p
            class={cn(
              'm-0 leading-none',
              // Second line indent from tablet up (Figma “      HELP WITH”)
              i === 1 && 'tb:ml-[0.75em] dk:ml-[1.15em]',
            )}
          >
            {line}
          </p>
        ))
      }
    </Copy>
  </div>

  <!-- mb/tb: stacked, right-aligned — same as Process (leading 25 / tracking 18) -->
  <div class="dk:hidden ml-auto w-fit pt-[1em]" data-anim="services-subtitle">
    <Copy
      variant="slide"
      type="chars"
      stagger={0.1}
      trigger="#services"
      start="top 50%"
      reverse
      delay={1}
    >
      {
        subtitleWords.map((word) => (
          <p
            class={cn(
              'font-neue-medium m-0 uppercase text-white',
              'text-[0.75rem] tb:text-[0.875rem]',
              'leading-[1.5625rem] tracking-[1.125rem]',
            )}
          >
            {word}
          </p>
        ))
      }
    </Copy>
  </div>

  <!-- dk+: single line, indented -->
  <div class="hidden dk:block">
    <Copy
      variant="slide"
      type="chars"
      stagger={0.1}
      trigger="#services"
      start="top 50%"
      reverse
      delay={1}
    >
      <p
        class={cn(
          'font-neue-medium relative uppercase text-white',
          'dk:text-[1rem] dk-lg:text-[1.25rem]',
          'pt-[1em]',
          // EN: "OUR SERVICES"
          !isEs && 'dk:tracking-[1.93rem] dk-lg:tracking-[3.5rem]',
          !isEs && 'dk:ml-[6.8rem] dk-lg:ml-[11.2rem]',
          // ES: "SERVICIOS"
          isEs && 'dk:tracking-[2.9rem] dk-lg:tracking-[5.1rem]',
          isEs && 'dk:ml-[6.5rem] dk-lg:ml-[10.75rem]',
        )}
        data-anim="services-subtitle-dk"
      >
        {subtitleDesktop}
      </p>
    </Copy>
  </div>
</div>
