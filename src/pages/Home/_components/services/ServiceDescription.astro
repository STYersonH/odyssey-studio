---
import { cn } from '../../../../lib/cn';
import Copy from '../../../../components/Copy/index.astro';

interface Props {
  text: string;
  /** Extra classes on the paragraph */
  class?: string;
  /** `desktop` = left column; `mobile` = under active list item */
  placement?: 'desktop' | 'mobile';
}

const { text, class: className = '', placement = 'desktop' } = Astro.props;
const isDesktop = placement === 'desktop';
---

<Copy
  variant="slideFromTop"
  type="lines"
  animateOnScroll={false}
  manual
  stagger={0.1}
  duration={0.5}
  ease="power3.out"
  class={cn(isDesktop ? 'hidden dk:block' : 'dk:hidden', 'w-full')}
>
  <p
    class={cn(
      'font-neue-medium m-0 text-[#666]',
      isDesktop
        ? 'max-w-[20.0625rem] text-[1.25rem] leading-[1.1]'
        : 'mt-[0.25rem] max-w-[20.0625rem] text-[0.875rem] leading-[1.3] tb:mt-[0.625rem] tb:text-[1.125rem]',
      className,
    )}
    data-anim="services-desc-text"
    data-copy-text
  >
    {text}
  </p>
</Copy>
