---
import AboutHeading from './AboutHeading.astro';
import AboutText from './AboutText.astro';
---

<section id="about"
         class="relative z-10 bg-[var(--color-neutral-900)] min-h-screen w-full flex items-center">
  <div class="w-full h-full
              flex flex-col gap-8 p-8
              md:gap-20 md:px-6 md:py-12  md:justify-end md:min-h-screen
              lg:gap-5 lg:px-12 lg:py-16 lg:items-stretch
              2xl:px-16 2xl:py-20">
    <div class="lg:col-span-7">
      <AboutHeading />
    </div>
    <AboutText />
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    if (typeof gsap === "undefined") return;

    // Content reveal — animates as the section scrolls into view
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#about",
        start: "top 80%",
        end: "top 20%",
        toggleActions: "play none none reverse",
      },
    });

    // Heading lines stagger in
    tl.from("[data-animate='about-heading'] p", {
      y: 50,
      opacity: 0,
      duration: 0.8,
      stagger: 0.15,
      ease: "power3.out",
    });

    // Text paragraphs stagger in
    tl.from(
      "[data-animate='about-text'] p",
      {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.2,
        ease: "power3.out",
      },
      "-=0.3"
    );
  });
</script>
