---
---

<div class="absolute inset-0 pointer-events-none z-[1]" data-animate="compass">
  <!-- N badge -->
  <span data-letter="N" class="absolute top-[28%] left-1/2 -translate-x-1/2">
    <span class="inline-flex items-center justify-center rounded-full bg-[var(--color-neutral-900)] text-white font-medium
                 w-4 h-4 text-[8px]
                 md:w-[22px] md:h-[22px] md:text-[18px]
                 lg:w-7 lg:h-7 lg:text-xs"
          style="font-family: var(--font-body)">
      N
    </span>
  </span>

  <!-- E -->
  <span data-letter="E" class="absolute font-normal text-[var(--color-neutral-900)] tracking-wide left-[3%] top-1/2 -translate-y-1/2
                               text-[8px] md:text-[18px] lg:text-sm"
        style="font-family: var(--font-body)">
    E
  </span>

  <!-- W -->
  <span data-letter="W" class="absolute font-normal text-[var(--color-neutral-900)] tracking-wide right-[3%] top-1/2 -translate-y-1/2
                               text-[8px] md:text-[18px] lg:text-sm"
        style="font-family: var(--font-body)">
    W
  </span>

  <!-- S -->
  <span data-letter="S" class="absolute font-normal text-[var(--color-neutral-900)] tracking-wide bottom-[28%] left-1/2 -translate-x-1/2
                               text-[8px] md:text-[18px] lg:text-sm"
        style="font-family: var(--font-body)">
    S
  </span>
</div>
