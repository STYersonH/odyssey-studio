---
import Button from '../button/index.astro';
import NavLinkItem from '../nav-link-item/index.astro';
---

<header class="fixed top-0 left-0 z-50 flex w-[100%]">
  <div class="mx-[40px] my-[24px] flex w-full items-center justify-between">
    <h2 class="font-neue-medium flex-1 text-[20px]">
      OD
      <span class="font-neue-medium-italic">Y</span>
      SSE
      <span class="font-neue-medium-italic">Y</span>
    </h2>
    <div class="flex flex-1 items-center justify-between">
      <nav>
        <ul class="flex gap-4">
          <li>
            <NavLinkItem href="/" label="About" />
          </li>
          <li>
            <NavLinkItem href="/" label="Work" />
          </li>
          <li>
            <NavLinkItem href="/" label="Services" />
          </li>
          <li>
            <NavLinkItem href="/" label="Process" />
          </li>
        </ul>
      </nav>
      <Button href="/contact" text="Start a project" />
    </div>
  </div>
</header>
