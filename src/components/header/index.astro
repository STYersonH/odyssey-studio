---
import Button from '../button/index.astro';
import MobileMenu from './MobileMenu.astro';
import NavLinkItem from '../nav-link-item/index.astro';
import type { Locale } from '../../i18n/locales';
import { DEFAULT_LOCALE } from '../../i18n/locales';
import { useTranslations } from '../../i18n/utils';
import { cn } from '../../lib/cn';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);

const alternateLang: Locale = lang === 'es' ? 'en' : 'es';
const basePath = Astro.url.pathname.replace(/^\/(es|en)(?=\/|$)/, '') || '/Home';
const alternateUrl = `/${alternateLang}${basePath.startsWith('/') ? basePath : `/${basePath}`}`;

const navLinks = t.header.navLinks;
---

<header class="pointer-events-none fixed top-0 left-0 z-50 w-full" data-header>
  <div
    class={cn(
      'pointer-events-auto flex w-full items-center',
      'px-5 pt-4',
      'dk:px-10 dk:pt-6',
    )}
    data-header-full
  >
    <div class="dk:flex-1">
      <a
        href={`/${lang}/Home`}
        class={cn(
          'font-neue-medium block text-primary-dark no-underline',
          'text-[16px]',
          'leading-[0.9]',
        )}
        data-header-logo
        aria-label={t.header.brandAriaLabel}
      >
        <span class="block whitespace-pre">
          OD<span class="font-neue-medium-italic">Y</span>
        </span>
        <span class="block whitespace-pre">
          {'     '}SSE<span class="font-neue-medium-italic">Y</span>
        </span>
      </a>
    </div>

    <div class="flex min-w-0 flex-1 items-center justify-end dk:justify-between">
      <nav class="hidden dk:block" aria-label="Primary">
        <ul class="m-0 flex list-none items-center gap-8 p-0">
          {
            navLinks.map((link) => (
              <li>
                <NavLinkItem href={`#${link.slug}`} label={link.label} />
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex shrink-0 items-center gap-3">
        <Button href="#contact" text={t.header.cta} />
        <Button
          href={alternateUrl}
          text={t.header.langSwitchLabel}
          type="secondary"
          icon={false}
          hover="text"
          aria-label={t.header.langSwitchAriaLabel}
          class="hidden min-w-0 dk:inline-flex"
        />
        <button
          type="button"
          data-mobile-menu-toggle
          data-close-aria={t.header.closeAriaLabel}
          aria-expanded="false"
          aria-label={t.header.mobileMenuAriaLabel}
          class={cn(
            'relative flex size-10 shrink-0 cursor-pointer items-center justify-center',
            'rounded-lg border-0 bg-white',
            'dk:hidden',
          )}
        >
          <span class="relative block size-4" data-mobile-menu-icon aria-hidden="true">
            <span
              data-mobile-menu-icon-top
              class="absolute top-1/2 left-0 h-px w-4 -translate-y-[3px] bg-primary-dark will-change-transform"
            ></span>
            <span
              data-mobile-menu-icon-bottom
              class="absolute top-1/2 left-0 h-px w-4 translate-y-[3px] bg-primary-dark will-change-transform"
            ></span>
          </span>
        </button>
      </div>
    </div>
  </div>
</header>

<MobileMenu
  navLinks={navLinks}
  alternateUrl={alternateUrl}
  langLabel={t.header.langSwitchLabel}
  langAriaLabel={t.header.langSwitchAriaLabel}
/>

<script>
  import { initHeaderAnimation } from './animation';

  const boot = () => initHeaderAnimation();
  boot();
  document.addEventListener('astro:page-load', boot);
</script>
