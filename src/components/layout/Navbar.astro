---

---

<nav
  data-animate="navbar"
  class="fixed top-0 left-0 z-50 w-full px-5 py-4 md:px-8 md:py-6"
>
  <div class="mx-auto flex max-w-[1400px] items-center justify-between">
    <span
      class="text-base font-bold tracking-[0.2em] text-[var(--color-neutral-900)] uppercase lg:text-sm"
      style="font-family: var(--font-display)"
    >
      ODYSSEY
    </span>

    <!-- Nav links: hidden on mobile/tablet, visible on desktop -->
    <div class="hidden gap-8 lg:flex">
      <a
        href="#about"
        class="text-sm font-normal tracking-wide text-[var(--color-neutral-900)] no-underline transition-opacity hover:opacity-60"
        style="font-family: var(--font-body)"
      >
        About
      </a>
      <a
        href="#work"
        class="text-sm font-normal tracking-wide text-[var(--color-neutral-900)] no-underline transition-opacity hover:opacity-60"
        style="font-family: var(--font-body)"
      >
        Work
      </a>
      <a
        href="#services"
        class="text-sm font-normal tracking-wide text-[var(--color-neutral-900)] no-underline transition-opacity hover:opacity-60"
        style="font-family: var(--font-body)"
      >
        Services
      </a>
      <a
        href="#process"
        class="text-sm font-normal tracking-wide text-[var(--color-neutral-900)] no-underline transition-opacity hover:opacity-60"
        style="font-family: var(--font-body)"
      >
        Process
      </a>
    </div>

    <!-- CTA: mobile/tablet = light bg + arrow icon, desktop = dark bg -->
    <a
      href="#contact"
      class="hover:opacitty-85 lg:bg-primary-dark lg:hover:text-primary-dark flex cursor-pointer items-center gap-2 rounded-lg bg-[var(--color-neutral-50)] px-2 py-1 text-sm tracking-wide text-[var(--color-neutral-900)] no-underline transition duration-700 ease-in-out lg:rounded-lg lg:px-5 lg:py-2.5 lg:font-medium lg:text-white lg:hover:bg-white"
      style="font-family: var(--font-body)"
    >
      Start a project
      <!-- Arrow icon: visible on mobile/tablet only -->
      <span
        class="lg:hover:bg-primary-dark inline-flex h-3 w-3 items-center justify-center rounded bg-[var(--color-accent)] md:hidden lg:hover:inline-flex lg:hover:text-white"
      >
        <svg
          width="8"
          height="8"
          viewBox="0 0 8 8"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M1 7L7 1M7 1H1M7 1V7"
            stroke="white"
            stroke-width="1.2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </a>
  </div>
</nav>
